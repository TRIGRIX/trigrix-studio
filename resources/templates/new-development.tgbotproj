      "position": {
        "x": 390.0,
        "y": 160.0
      },
      "settings": {
        "text": "Hello there! How can we help?",
        "html": true,
        "disable_preview": true,
        "edit_navigation_message": true,
        "buttons": [
          {
            "id": "request",
            "text": "Leave the application",
            "type": "transition",
