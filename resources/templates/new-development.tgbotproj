          },
          {
            "id": "services",
            "text": "Choosing a favor",
            "type": "transition",
            "url": ""
          },
          {
            "id": "faq",
            "text": "How the work goes",
            "type": "transition",
            "url": ""
          }
        ],
        "columns": 1,
        "keyboard": "inline"
      },
      "required": true,
      "group": "Main menu"
    },
    {
      "id": "services",
      "type": "dictionary_select",
      "title": "Offering",
      "position": {
        "x": 780.0,
        "y": 80.0
      },
      "settings": {
        "text": "Choose a service or direction:",
        "dictionary": "SERVICES",
        "title_field": "title",
        "variable": "service",
        "columns": 1
      },
      "required": true,
      "group": "Application"
    },
    {
      "id": "ask_name",
      "type": "question",
      "title": "Name.",
      "position": {
        "x": 1170.0,
        "y": 80.0
      },
      "settings": {
        "text": "How do I address you?",
        "answer_type": "text",
        "required": true,
        "min_length": null,
        "max_length": 100,
        "pattern": "",
        "variable": "client_name",
        "persist": true,
        "invalid_message": "Check the format of the answer and try again."
      },
      "required": true,
      "group": "Application"
    },
    {
      "id": "ask_contact",
      "type": "question",
      "title": "Contact",
      "position": {
        "x": 1510.0,
        "y": 80.0
      },
      "settings": {
        "text": "Specify the phone, email or convenient method of communication.",
        "answer_type": "text",
        "required": true,
        "min_length": null,
        "max_length": 120,
        "pattern": "",
        "variable": "client_contact",
        "persist": true,
        "invalid_message": "Check the format of the answer and try again."
      },
      "required": true,
      "group": "Application"
    },
    {
      "id": "ask_details",
      "type": "question",
      "title": "Description of the task",
      "position": {
        "x": 1850.0,
        "y": 80.0
      },
      "settings": {
        "text": "Specify the area, area, budget, method of payment and time of purchase.",
        "answer_type": "text",
        "required": true,
        "min_length": null,
        "max_length": 1000,
        "pattern": "",
        "variable": "details",
        "persist": true,
        "invalid_message": "Check the format of the answer and try again."
      },
      "required": true,
      "group": "Application"
    },
    {
      "id": "request_id",
      "type": "request_id",
      "title": "Number of treatment",
      "position": {
        "x": 2190.0,
        "y": 80.0
      },
      "settings": {
        "prefix": "REQ",
        "random_length": 6,
        "variable": "request_id"
      },
      "required": true,
      "group": "Application"
    },
    {
      "id": "notify",
      "type": "card",
      "title": "Request summary",
      "position": {
        "x": 2530.0,
        "y": 80.0
      },
      "settings": {
        "recipient": "requests",
        "text": "ID: {{ request_id }}\nService: {{ service.title }}\nName: {{ client_name }}\nContact: {{ client_contact }}\nRequest: {{ details }}\nTelegram: @{{ user.username }}\nTelegram ID: {{ user.id }}",
        "title": "NEW REQUEST"
      },
      "required": true,
      "group": "Application"
    },
    {
      "id": "finish",
      "type": "finish",
      "title": "Application accepted",
      "position": {
        "x": 2870.0,
        "y": 80.0
      },
      "settings": {
        "text": "Thank you! Address   {{ request_id }}  has been forwarded to the team.",
        "show_main_menu": true
      },
      "required": true,
      "group": "Application"
    },
    {
      "id": "faq",
      "type": "finish",
      "title": "How the work goes",
      "position": {
        "x": 780.0,
        "y": 560.0
      },
      "settings": {
        "text": "We will clarify the task, offer the appropriate format, agree on the cost and timing, then contact you.",
        "show_main_menu": true
      },
      "required": true,
      "group": "Information"
    }
