    "template": "lead-quiz",
    "product": "TRIGRIX Studio"
  },
  "bot": {
    "display_name": "Your bot name",
    "username": "",
    "about": "Company assistant",
    "description": "Collection and forwarding of applications",
    "parse_mode": "HTML",
    "allowed_updates": [
      "message",
      "callback_query"
    ],
    "commands": [
      {
        "command": "start",
        "description": "Main menu"
      }
    ]
  },
  "variables": [
    {
      "name": "name",
      "type": "string",
      "persistence": "context",
      "max_length": 80
    },
    {
      "name": "phone",
      "type": "string",
      "persistence": "context",
      "max_length": 32
    },
    {
      "name": "request_id",
      "type": "string",
      "persistence": "context",
      "max_length": 24
    }
  ],
  "environment": [
    {
      "name": "BOT_TOKEN",
      "description": "Telegram bot token",
      "kind": "secret",
      "required": true,
      "example": "",
      "platforms": [
        "cloudflare",
        "docker"
      ]
    },
    {
      "name": "WEBHOOK_SECRET",
      "description": "Webhook verification secret",
      "kind": "secret",
      "required": true,
      "example": "",
