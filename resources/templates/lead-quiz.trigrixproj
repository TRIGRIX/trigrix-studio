        "cloudflare",
        "docker"
      ]
    }
  ],
  "dictionaries": [],
  "contacts": [],
  "recipients": [
    {
      "id": "admin",
      "title": "Administrator",
      "chat_id_env": "ADMIN_CHAT_ID"
    }
  ],
  "channels": [
    {
      "id": "telegram_default",
      "type": "telegram",
      "title": "Telegram",
      "enabled": true,
      "account_id": "default",
      "credentials": {
        "bot_token": "BOT_TOKEN"
      },
      "webhook_path": "/webhook/telegram",
      "webhook_secret_env": "WEBHOOK_SECRET",
      "settings": {
        "admin_chat_id_env": "ADMIN_CHAT_ID",
        "admin_thread_id": null
      }
    },
    {
      "id": "whatsapp_default",
      "type": "whatsapp",
      "title": "WhatsApp Business",
      "enabled": false,
      "account_id": "default",
      "credentials": {
