        "variable": "lead_phone",
        "persist": true,
        "invalid_message": "Check the format of the answer and try again.",
        "field": "phone"
      },
      "required": true,
      "group": "Lead"
    },
    {
      "id": "email",
      "type": "collect_lead_field",
      "title": "Email",
      "position": {
        "x": 1040.0,
        "y": 80.0
      },
      "settings": {
        "text": "Enter your email address.",
        "answer_type": "email",
        "required": true,
        "min_length": null,
        "max_length": 160,
        "pattern": "",
        "variable": "lead_email",
        "persist": true,
        "invalid_message": "Check the format of the answer and try again.",
        "field": "email"
      },
      "required": true,
      "group": "Lead"
    },
    {
      "id": "country",
      "type": "collect_lead_field",
      "title": "Country",
      "position": {
        "x": 1380.0,
        "y": 80.0
      },
      "settings": {
        "text": "Country or region",
        "answer_type": "text",
        "required": true,
        "min_length": null,
        "max_length": 80,
        "pattern": "",
        "variable": "lead_country",
        "persist": true,
        "invalid_message": "Check the format of the answer and try again.",
        "field": "country"
      },
      "required": true,
      "group": "Lead"
    },
    {
      "id": "details",
      "type": "collect_lead_field",
      "title": "Request",
      "position": {
        "x": 1720.0,
        "y": 80.0
      },
      "settings": {
        "text": "Describe your request.",
        "answer_type": "text",
        "required": true,
        "min_length": null,
        "max_length": 1000,
        "pattern": "",
        "variable": "answer_details",
        "persist": true,
        "invalid_message": "Check the format of the answer and try again.",
        "field": "free_answer"
      },
      "required": true,
      "group": "Lead"
    },
    {
      "id": "request_id",
      "type": "request_id",
      "title": "Lead ID",
      "position": {
        "x": 2060.0,
        "y": 80.0
      },
      "settings": {
        "prefix": "LEAD",
        "random_length": 6,
        "variable": "request_id"
      },
      "required": true,
      "group": "Delivery"
    },
    {
      "id": "complete",
      "type": "complete_lead",
      "title": "Complete lead",
      "position": {
        "x": 2400.0,
        "y": 80.0
      },
      "settings": {
        "lead_id_variable": "request_id",
        "name_variable": "lead_name",
        "phone_variable": "lead_phone",
        "email_variable": "lead_email",
        "country_variable": "lead_country",
        "answers_prefix": "answer_",
        "output_variable": "lead"
      },
      "required": true,
      "group": "Delivery"
    },
    {
      "id": "firebase",
      "type": "save_lead",
      "title": "Save to Firebase",
      "position": {
        "x": 2740.0,
        "y": 80.0
      },
      "settings": {
        "storage": "project_default",
        "lead_variable": "lead",
        "continue_on_error": true
      },
      "required": true,
      "group": "Delivery"
    },
    {
      "id": "email_notify",
      "type": "notify_email",
      "title": "Notify Email",
      "position": {
        "x": 3080.0,
        "y": 80.0
      },
      "settings": {
        "email_profile": "project_default",
        "lead_variable": "lead",
        "continue_on_error": true
      },
      "required": true,
      "group": "Delivery"
    },
    {
      "id": "crm",
      "type": "push_crm",
      "title": "Push to CRM",
      "position": {
        "x": 3420.0,
        "y": 80.0
      },
      "settings": {
        "crm_id": "crm_main",
        "lead_variable": "lead",
        "operation": "create_lead",
        "continue_on_error": true
      },
      "required": true,
      "group": "Delivery"
    },
    {
      "id": "admin",
      "type": "send_admin_summary",
      "title": "Admin summary",
      "position": {
        "x": 3760.0,
        "y": 80.0
      },
      "settings": {
        "recipient": "admin",
        "lead_variable": "lead",
        "title": "NEW LEAD",
        "template": "ID: {{ lead.lead_id }}\nName: {{ lead.name }}\nPhone: {{ lead.phone }}\nEmail: {{ lead.email }}\nCountry: {{ lead.country }}"
      },
      "required": true,
      "group": "Delivery"
    },
    {
      "id": "export",
      "type": "export_leads",
      "title": "Admin export",
      "position": {
        "x": 4100.0,
        "y": 80.0
      },
      "settings": {
        "period": "all",
        "format": "xlsx",
        "recipient": "admin",
        "admin_only": true,
        "channel": "",
        "project": "",
        "status": "",
        "source": "",
        "owner": ""
      },
      "required": true,
      "group": "Delivery"
    },
    {
      "id": "finish",
      "type": "finish",
      "title": "Completed",
      "position": {
        "x": 4440.0,
        "y": 80.0
      },
      "settings": {
        "text": "Thank you. Your request {{ request_id }} has been received.",
        "show_main_menu": true
      },
      "required": true,
      "group": "Finish"
    }
  ],
