      "position": {
        "x": 360.0,
        "y": 80.0
      },
      "settings": {
        "text": "What is your name?",
        "answer_type": "text",
        "required": true,
        "min_length": null,
        "max_length": 100,
        "pattern": "",
        "variable": "lead_name",
        "persist": true,
        "invalid_message": "Check the format of the answer and try again.",
        "field": "name"
      },
      "required": true,
      "group": "Lead"
    },
