function setupPage(result="",status=200) {
  const output=result?`<h2>${html(SETUP_UI.result)}</h2><pre>${html(result)}</pre>`:"";
  return new Response(`<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>${html(SETUP_UI.title)}</title><style>body{font:16px system-ui;max-width:760px;margin:40px auto;padding:0 20px;color:#172033}form{display:grid;gap:12px;margin:20px 0}input,button{font:inherit;padding:12px;border-radius:8px;border:1px solid #9aa4b2}button{cursor:pointer;background:#eef2ff}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f4f6f8;padding:16px;border-radius:8px}</style></head><body><h1>${html(SETUP_UI.title)}</h1><p>${html(SETUP_UI.safe)}</p><form method="post"><label>${html(SETUP_UI.secret)}<input type="password" name="secret" autocomplete="off" required></label><button name="action" value="register">${html(SETUP_UI.register)}</button><button name="action" value="check">${html(SETUP_UI.check)}</button></form>${output}</body></html>`,{status,headers:{"Content-Type":"text/html; charset=utf-8","Cache-Control":"no-store","X-Frame-Options":"DENY","Referrer-Policy":"no-referrer"}});
