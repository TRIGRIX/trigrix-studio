async function hmacHex(secret, raw) {
  const key=await crypto.subtle.importKey("raw",encoder.encode(secret),{name:"HMAC",hash:"SHA-256"},false,["sign"]);
  return [...new Uint8Array(await crypto.subtle.sign("HMAC",key,encoder.encode(raw)))].map(byte=>byte.toString(16).padStart(2,"0")).join("");
}

async function verifyChannelSignature(kind, raw, secret, signature) {
  if (!secret || !signature) return false;
  const expected=await hmacHex(secret,raw);
  return kind === "viber" ? signature === expected : signature === `sha256=${expected}`;
}

